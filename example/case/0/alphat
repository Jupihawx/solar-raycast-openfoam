FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Turbulent thermal diffusivity rho*nut/Prt [kg/m/s]

dimensions      [1 -1 -1 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    "(inlet|outlet)"
    {
        type            calculated;
        value           uniform 0;
    }
    "(sides|top)"
    {
        type            symmetry;
    }
    "(Buildings|Terrain)"
    {
        type            compressible::alphatWallFunction;
        Prt             0.85;
        value           uniform 0;
    }
}
// ************************************************************************* //
